generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum TradeMode {
  LIVE
  PAPER
}

enum TradeRoute {
  MICIN
  WHALE
}

enum TokenSafetyProbeVerdict {
  PASSED
  BLOCKED
  INCONCLUSIVE
}

enum TelegramChatType {
  PRIVATE
  GROUP
  SUPERGROUP
  CHANNEL
}

enum TelegramChatStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum WithdrawalAmountMode {
  PERCENT
  USD
}

enum WithdrawalStatus {
  PENDING
  SUCCESS
  FAILED
}

model TelegramChat {
  id                Int                     @id @default(autoincrement())
  chatId            String                  @unique
  chatType          TelegramChatType
  title             String?
  username          String?
  status            TelegramChatStatus      @default(ACTIVE)
  lastSeenAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  walletVault       TelegramWalletVault?
  deposits          TelegramDepositLedger[]
  settings          TelegramChatSetting?
  trades            Trade[]
  withdrawals       TelegramWithdrawal[]
  tokenSafetyProbes TokenSafetyProbe[]

  @@index([status, chatType])
  @@index([lastSeenAt])
}

model TelegramWalletVault {
  id                   Int          @id @default(autoincrement())
  telegramChatId       Int          @unique
  publicKey            String       @unique
  balanceSol           Float        @default(0)
  encryptedSecretKey   String
  initializationVector String
  authTag              String
  keyVersion           Int          @default(1)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  chat                 TelegramChat @relation(fields: [telegramChatId], references: [id], onDelete: Cascade)
}

model TelegramDepositLedger {
  id              Int          @id @default(autoincrement())
  telegramChatId  Int
  walletPublicKey String
  signature       String
  amountSol       Float
  slotNumber      Int?
  txTimestamp     DateTime?
  createdAt       DateTime     @default(now())
  chat            TelegramChat @relation(fields: [telegramChatId], references: [id], onDelete: Cascade)

  @@unique([signature, walletPublicKey])
  @@index([telegramChatId, createdAt])
  @@index([walletPublicKey])
}

model TelegramChatSetting {
  id              Int          @id @default(autoincrement())
  telegramChatId  Int          @unique
  totalSlots      Int          @default(2)
  positionSizeUsd Float        @default(5)
  slippageOnSol   Float        @default(0.005)
  dryRun          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  chat            TelegramChat @relation(fields: [telegramChatId], references: [id], onDelete: Cascade)
}

model TelegramWithdrawal {
  id                   Int                  @id @default(autoincrement())
  telegramChatId       Int
  destinationAddress   String
  amountMode           WithdrawalAmountMode
  requestedAmount      Float
  amountTransferredSol Float?
  balanceBeforeSol     Float?
  balanceAfterSol      Float?
  status               WithdrawalStatus     @default(PENDING)
  txHash               String?
  errorMessage         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  chat                 TelegramChat         @relation(fields: [telegramChatId], references: [id], onDelete: Cascade)

  @@index([telegramChatId, createdAt])
  @@index([telegramChatId, status])
}

model Trade {
  id                      Int                 @id @default(autoincrement())
  telegramChatId          Int?
  tokenMint               String
  symbol                  String?             @default("UNKNOWN")
  slotNumber              Int
  entryPrice              Float
  highestPrice            Float
  trailingStopPrice       Float
  exitPrice               Float?
  exitReason              String?
  profitUsd               Float?
  netProfitUsd            Float?
  entryPriceUsd           Float?
  entryPriceSol           Float?
  // Entry price as reported by the SAME feed PriceMonitorService polls (DexScreener), in SOL.
  // entryPrice is the actual on-chain fill, which on a fast-moving token can sit several percent
  // away from what DexScreener reports for tens of seconds. Measuring stop-loss/trailing against
  // the fill while reading the feed produced instant phantom stop-losses. Nullable so pre-existing
  // trades keep falling back to entryPrice. Accounting/PnL still uses entryPriceSol/entryPriceUsd.
  monitorEntryPrice       Float?
  exitPriceUsd            Float?
  exitPriceSol            Float?
  exitTriggerPriceUsd     Float?
  exitTriggerPriceSol     Float?
  exitTriggerPnlPercent   Float?
  entryLiquidity          Float?
  entryPairAddress        String?
  entryMarketCap          Float?
  solPriceAtEntry         Float?
  entryValueUsd           Float?
  status                  TradeStatus         @default(OPEN)
  mode                    TradeMode           @default(LIVE)
  route                   TradeRoute?
  aiDecisionSnapshotId    Int?
  aiCutlossDefenseCount   Int                 @default(0)
  aiCutlossLastAt         DateTime?
  aiCutlossReason         String?
  amountInSol             Float
  buyTxHash               String?
  sellTxHash              String?
  feesPaid                Float?
  totalFeesSol            Float?
  creatorAddress          String?
  topHolderAddress        String?
  initialCreatorBalance   Float?
  initialTopHolderBalance Float?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  slTriggeredAt           DateTime?
  partialTakeProfitAt     DateTime?
  targetTakeProfit        Float?
  targetStopLoss          Float?
  targetTrailingDistance  Float?
  metaLabel               String?
  telegramChat            TelegramChat?       @relation(fields: [telegramChatId], references: [id], onDelete: SetNull)
  aiDecisionSnapshot      AiDecisionSnapshot? @relation(fields: [aiDecisionSnapshotId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([mode, status])
  @@index([route, status, mode])
  @@index([tokenMint, createdAt])
  @@index([telegramChatId, status, mode])
  @@index([metaLabel, status, mode])
}

model TokenSafetyProbe {
  id             Int                     @id @default(autoincrement())
  telegramChatId Int
  tokenMint      String
  walletAddress  String
  amountUsd      Float
  verdict        TokenSafetyProbeVerdict
  reason         String?
  buyTxHash      String?
  sellTxHash     String?
  expiresAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  chat           TelegramChat            @relation(fields: [telegramChatId], references: [id], onDelete: Cascade)

  @@unique([telegramChatId, tokenMint])
  @@index([tokenMint, verdict])
  @@index([expiresAt])
}

model AiDecisionSnapshot {
  id        Int        @id @default(autoincrement())
  tokenMint String
  route     TradeRoute
  metrics   Json
  result    Json
  createdAt DateTime   @default(now())
  trades    Trade[]

  @@index([tokenMint, createdAt])
  @@index([route, createdAt])
}

enum WatchlistStatus {
  PENDING
  TRADED
  FAILED
}

model Watchlist {
  id                       Int             @id @default(autoincrement())
  tokenMint                String          @unique
  symbol                   String?
  tokenName                String?
  mcap                     Float?
  liquidity                Float?
  volumeSurge              Float?
  volScore                 Float?
  zScore                   Float?
  priceChange1h            Float?
  isPumpFun                Boolean         @default(false)
  hasWebsite               Boolean?
  hasTwitter               Boolean?
  hasTelegram              Boolean?
  isDexPaidUpdated         Boolean?
  isCommunityTakeover      Boolean?
  whaleSignalScore         Float?
  pairCreatedAt            DateTime?
  entryConfirmStartedAt    DateTime?
  entryConfirmPriceUsd     Float?
  entryConfirmLiquidityUsd Float?
  entryConfirmBuys5m       Int?
  entryConfirmSells5m      Int?
  entryConfirmCount        Int             @default(0)
  checkCount               Int             @default(0)
  lastCheckedAt            DateTime        @default(now())
  createdAt                DateTime        @default(now())
  status                   WatchlistStatus @default(PENDING)
  reason                   String?

  @@index([status, lastCheckedAt])
  @@index([createdAt, status])
  @@index([pairCreatedAt, createdAt])
}

// Narrative verdicts are static per token: a name and its social links do not change minute to
// minute the way price and volume do. They therefore live in their own table rather than on
// Watchlist, whose FAILED/PENDING rows are hard-deleted after 24 hours — which would drop the
// verdict for exactly the mints the scanner re-encounters.
model TokenNarrative {
  tokenMint   String   @id
  verdict     String
  confidence  String
  reasoning   String?
  // Label from the deterministic regex matcher, kept alongside so the LLM verdict can be judged
  // against the free baseline instead of being trusted on its own.
  label       String?
  evaluatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([verdict])
  @@index([evaluatedAt])
}

model CreatorProfile {
  address       String   @id
  tokensCreated Int      @default(1)
  ruggedTokens  Int      @default(0)
  riskScore     Float    @default(0)
  isBlacklisted Boolean  @default(false)
  reason        String?
  tags          String[] @default([])
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isBlacklisted])
  @@index([riskScore])
}

model TokenMetaLabel {
  tokenMint  String   @id
  label      String
  tokenName  String?
  symbol     String?
  confidence String?
  source     String   @default("llm")
  labeledAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([label, labeledAt])
}

// One row per sighting, not per token. This is what makes "that meta is busy right now" a
// measurement instead of a guess: the same mint seen in three separate windows is three pieces of
// evidence. Pruned outside META_WINDOW_HOURS, so the table stays bounded by traffic, not by time.
model MetaSighting {
  id           Int      @id @default(autoincrement())
  label        String
  tokenMint    String
  volume5m     Float?
  liquidityUsd Float?
  isBoosted    Boolean  @default(false)
  seenAt       DateTime @default(now())

  @@index([label, seenAt])
  @@index([seenAt])
}

model MetaVocabulary {
  label       String   @id
  aliases     String[] @default([])
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  retired     Boolean  @default(false)
}

// Every directional call on SOL, written down before the outcome is known and graded once the
// horizon passes.
//
// Persisted rather than held in memory precisely because the stakes are low: predictions lost to a
// restart would make the hit rate a figure computed from a self-selected sample, and a biased
// accuracy number is worse than no accuracy number -- it would make a signal look trustworthy on
// exactly the runs that happened not to crash.
//
// A pre-ship backtest over 94 calls on 24h of real SOL prices scored 73.4% against a 78.7%
// "always answer FLAT" baseline, and 11% on the nine calls where it actually committed to a
// direction. The feature therefore starts in shadow: rows accumulate here, nothing is sent.
model SolPrediction {
  id                Int       @id @default(autoincrement())
  madeAt            DateTime  @default(now())
  horizonMinutes    Int
  direction         String
  confidence        String
  score             Float
  // The exact feature vector behind the call, so a wrong prediction can be re-read later instead
  // of merely counted.
  features          Json
  solPriceAtMade    Float
  resolveAt         DateTime
  resolvedAt        DateTime?
  solPriceAtResolve Float?
  actualChangePct   Float?
  correct           Boolean?

  @@index([resolveAt, resolvedAt])
  @@index([madeAt])
}
